# Salin ke .env.local lalu isi nilainya. Panduan lengkap: supabase/README.md

# --- AI assistant (sudah ada) ---
GEMINI_API_KEY=
NEXT_PUBLIC_GOOGLE_SEARCH_ID=

# --- Supabase CMS ---
# Supabase Dashboard → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — aman untuk browser. Boleh juga legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — HANYA untuk `npm run cms:migrate` di komputer sendiri.
# Jangan dimasukkan ke Vercel & jangan pernah di-commit.
SUPABASE_SECRET_KEY=

# --- Form kontak (src/app/api/contact) — panduan: supabase/README.md → Form kontak ---
# Rahasia acak antara website & fungsi database submit_contact_message (hash-nya disimpan di
# private.contact_form_secret). Server-only: jangan pakai awalan NEXT_PUBLIC_.
CONTACT_FORM_SECRET=
# Cloudflare Turnstile (anti-spam): Cloudflare Dashboard → Turnstile → widget filoalvian.com
# Dev lokal boleh memakai key uji resmi: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (email notifikasi pesan baru ke filoalvianongky@gmail.com): resend.com → API Keys
RESEND_API_KEY=
# Opsional: pengirim dari domain sendiri yang sudah diverifikasi di Resend, mis. "FiloAlvian.com <halo@filoalvian.com>".
# Kosong = onboarding@resend.dev (hanya bisa mengirim ke email pemilik akun Resend).
CONTACT_FROM_EMAIL=
